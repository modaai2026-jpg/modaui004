# Local environment template for MODAUI.
# Copy to .env and replace placeholders with real values.

# Runtime settings
NODE_ENV=development
PORT=3000

# App URLs
API_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000
API_BASE=http://localhost:3000

# AI provider keys
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OLLAMA_BASE_URL="http://localhost:11434"

# Payment provider credentials
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"
WECHAT_APP_ID="MY_WECHAT_APP_ID"
WECHAT_APP_SECRET="MY_WECHAT_APP_SECRET"
WECHAT_MCH_ID="MY_WECHAT_MCH_ID"
WECHAT_API_KEY="MY_WECHAT_API_KEY"
PAYPAL_CLIENT_ID="MY_PAYPAL_CLIENT_ID"
PAYPAL_CLIENT_SECRET="MY_PAYPAL_CLIENT_SECRET"
PAYPAL_MODE="sandbox"

# OAuth / social login
GITHUB_CLIENT_ID="MY_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="MY_GITHUB_CLIENT_SECRET"
TIKO_CLIENT_ID="MY_TIKO_CLIENT_ID"
TIKO_CLIENT_SECRET="MY_TIKO_CLIENT_SECRET"

# Frontend dev server
VITE_HOST=0.0.0.0
VITE_PORT=5173
DISABLE_HMR=false

# Worker / auxiliary process
POLL_INTERVAL_MS=5000
WORKER_ID=worker_local

# Optional
# CLIENT_IP=203.0.113.1
